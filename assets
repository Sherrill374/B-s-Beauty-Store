/* General Styles */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    line-height: 1.6;
    background-color: #f9f9f9;
    color: #333;
    animation: fadeIn 1.2s ease-in;
}

header {
    background-color: #0077cc;
    color: white;
    padding: 1rem;
    text-align: center;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav li {
    display: inline-block;
    margin: 0 15px;
}

nav a {
    color: white;
    text-decoration: none;
    padding: 5px 10px;
    transition: background-color 0.3s ease;
}

nav a:hover {
    background-color: #005fa3;
    border-radius: 5px;
}

main {
    padding: 20px;
}

/* Blog Section Layout */
.blog-section {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
}

.blog-post {
    background-color: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    flex: 1 1 45%;
    transition: transform 0.3s ease;
}

.blog-post:hover {
    transform: translateY(-5px);
}

/* Contact Form */
.contact-section {
    margin-top: 40px;
    background-color: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

form {
    display: flex;
    flex-direction: column;
}

label {
    margin-top: 10px;
    font-weight: bold;
}

input, textarea, button {
    margin-top: 5px;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 1rem;
    transition: border-color 0.3s ease, background-color 0.3s ease;
}

input:focus, textarea:focus {
    border-color: #0077cc;
    background-color: #eef6fc;
    outline: none;
}

button {
    background-color: #0077cc;
    color: white;
    margin-top: 15px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

button:hover {
    background-color: #005fa3;
}

/* Footer */
footer {
    background-color: #0077cc;
    color: white;
    text-align: center;
    padding: 15px 0;
    margin-top: 40px;
}

/* Animations */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* Responsive Layouts */

/* Phones */
@media (max-width: 767px) {
    .blog-section {
        flex-direction: column;
    }

    .blog-post {
        flex: 1 1 100%;
    }

    nav li {
        display: block;
        margin: 10px 0;
    }
}

/* Tablets */
@media (min-width: 768px) and (max-width: 1024px) {
    .blog-section {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .blog-post {
        flex: 1 1 48%;
    }
}

/* Desktops */
@media (min-width: 1025px) {
    .blog-section {
        flex-direction: row;
    }

    .blog-post {
        flex: 1 1 45%;
    }
}
